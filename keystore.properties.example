# Copy to keystore.properties (git-ignored) and fill in to sign release builds for Google Play.
# Create the key once with (keep the .jks and passwords somewhere safe — losing them means you
# can't update the app on Play unless you use Play App Signing's upload-key reset):
#   keytool -genkeypair -v -keystore heavyduty-release.jks -alias heavyduty \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=heavyduty-release.jks
storePassword=CHANGE_ME
keyAlias=heavyduty
keyPassword=CHANGE_ME
